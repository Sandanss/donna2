{
  "expo": {
    "name": "Donna Companion",
    "slug": "donna-caregiver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "donna",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#4A5D4F"
    },
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.donna.caregiver",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSFaceIDUsageDescription": "Use Face ID for quick sign-in",
        "NSCameraUsageDescription": "Donna uses the camera to let you set a profile photo",
        "NSPhotoLibraryUsageDescription": "Donna uses your photo library to let you set a profile photo"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FDFCF8"
      },
      "package": "com.donna.caregiver"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#4A5D4F",
          "ios": {
            "image": "./assets/images/splash.png",
            "resizeMode": "cover",
            "backgroundColor": "#4A5D4F",
            "enableFullScreenImage_legacy": true
          },
          "android": {
            "image": "./assets/images/splash.png",
            "resizeMode": "cover",
            "backgroundColor": "#4A5D4F"
          }
        }
      ],
      "expo-system-ui",
      "expo-apple-authentication",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa482a04-3f14-4373-a654-42e51f1bd7b0"
      }
    },
    "owner": "dmdzco"
  }
}
